# 이 파일을 복사해서 application-local.yml 로 만들고 실제 값을 채우세요.
# cp application-local.yml.example application-local.yml
# application-local.yml 은 .gitignore 처리되어 있습니다.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/portai?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver
